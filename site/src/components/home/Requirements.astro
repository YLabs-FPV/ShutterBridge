---
import { Icon } from "astro-icon/components";
import { REQUIRED } from "../../consts";

const icons = ["mdi:chip", "betaflight", "mdi:camera"];
---

<section class="px-6 py-12" id="requirements">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-center">What you need</h2>
    <p class="mt-2 text-center text-[rgb(var(--color-text-muted))]">
      Three things to get flying
    </p>

    <div class="mt-4 grid gap-5 md:grid-cols-3">
      {
        REQUIRED.map((item, i) => (
          <div class="rounded-2xl border border-[rgb(var(--color-border))] bg-[rgb(var(--color-card-bg))] p-6 shadow-sm">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-[rgba(var(--color-primary),0.1)] text-[rgb(var(--color-primary))]">
              <Icon
                name={icons[i]}
                class={icons[i] === "betaflight" ? "w-7 h-7" : "w-6 h-6"}
              />
            </div>
            <h3 class="mt-6 text-lg font-bold">{item.name}</h3>
            <p class="mt-2 text-sm text-[rgb(var(--color-text-muted))]">
              {item.detail}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
