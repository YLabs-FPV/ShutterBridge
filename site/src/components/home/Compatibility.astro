---
import CameraMatrix from "../CameraMatrix.astro";
import { getLangFromUrl, useTranslations } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="px-6 pt-12 pb-4" id="cameras">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-center">{t("compat.title")}</h2>
    <p class="mt-2 mb-4 text-center text-[rgb(var(--color-text-muted))]">
      {t("compat.subtitle")}
    </p>
    <CameraMatrix />
  </div>
</section>
