---
const slots = [
  {
    type: "video",
    src: "/gallery/arming.mp4",
    label: "Arm to record",
    caption: "Recording starts the moment you arm; no extra button presses.",
  },
  {
    type: "video",
    src: "/gallery/osd.mp4",
    label: "OSD in the goggles",
    caption: "Live camera status overlaid right where you're looking.",
  },
  {
    type: "themed-image",
    lightSrc: "/gallery/ui-light.webp",
    darkSrc: "/gallery/ui-dark.webp",
    label: "Web UI",
    caption: "Configure everything from a clean browser interface.",
  },
] as const;
---

<section class="px-6 pt-8 pb-4" id="gallery">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-center">See it in action</h2>
    <p class="mt-2 text-center text-[rgb(var(--color-text-muted))]">
      Live camera status, right where you're looking
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        slots.map((s) => (
          <figure>
            <div class="group relative aspect-video rounded-2xl border border-[rgb(var(--color-border))] bg-[rgb(var(--color-secondary))] overflow-hidden">
              {s.type === "video" ? (
                <video
                  class="w-full h-full object-cover"
                  src={s.src}
                  autoplay
                  loop
                  muted
                  playsinline
                  aria-label={s.label}
                />
              ) : (
                <>
                  <img
                    class="light-only w-full h-full object-cover"
                    src={s.lightSrc}
                    alt={s.label}
                    loading="lazy"
                  />
                  <img
                    class="dark-only w-full h-full object-cover"
                    src={s.darkSrc}
                    alt={s.label}
                    loading="lazy"
                  />
                </>
              )}
            </div>
            <figcaption class="mt-3 px-1">
              <span class="block text-sm font-semibold">{s.label}</span>
              <span class="mt-0.5 block text-sm text-[rgb(var(--color-text-muted))]">
                {s.caption}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Default (auto): use system preference */
  .light-only {
    display: block;
  }
  .dark-only {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .light-only {
      display: none;
    }
    .dark-only {
      display: block;
    }
  }

  /* Explicit light mode */
  :global(html.light) .light-only {
    display: block !important;
  }
  :global(html.light) .dark-only {
    display: none !important;
  }

  /* Explicit dark mode */
  :global(html.dark) .light-only {
    display: none !important;
  }
  :global(html.dark) .dark-only {
    display: block !important;
  }
</style>
