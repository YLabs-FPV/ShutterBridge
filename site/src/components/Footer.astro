---
import Socials from "./Socials.astro";
import { AUTHOR } from "../consts";

const year = new Date().getFullYear();
---

<footer
  class="w-full py-8 px-6 bg-[rgb(var(--color-footer-bg))] border-t border-[rgb(var(--color-border))] text-[rgb(var(--color-text-muted))] text-center mt-auto"
>
  <div class="max-w-6xl mx-auto">
    <div
      class="flex flex-col md:flex-row md:justify-between items-center gap-4"
    >
      <div class="text-sm">&copy; {year} {AUTHOR}</div>
      <Socials />
    </div>
  </div>
</footer>
