---
import { Icon } from "astro-icon/components";
import { CAMERAS, FEATURES, type Feature, type Support } from "../consts";

const cell = (s: Support) =>
  s === "yes"
    ? { icon: "mdi:check-circle", cls: "text-emerald-500" }
    : s === "partial"
      ? { icon: "mdi:circle-slice-5", cls: "text-[rgb(var(--color-accent))]" }
      : { icon: "mdi:close-circle", cls: "text-[rgb(var(--color-danger))]" };

const columns: { label: string; key: keyof Omit<Feature, "label"> }[] = [
  { label: "Osmo (Nano)", key: "osmoNano" },
  { label: "Action / 360", key: "action" },
  { label: "GoPro", key: "gopro" },
];
---

<div class="grid gap-5 md:grid-cols-3">
  {
    CAMERAS.map((cam) => (
      <div class="rounded-2xl border border-[rgb(var(--color-border))] bg-[rgb(var(--color-card-bg))] p-6 shadow-sm">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[rgb(var(--color-secondary))] text-[rgb(var(--color-text-muted))]">
            {cam.tag}
          </span>
          {cam.tested ? (
            <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-500">
              <Icon name="mdi:check-decagram" class="w-4 h-4" /> Tested
            </span>
          ) : (
            <span class="inline-flex items-center gap-1 text-xs font-medium text-[rgb(var(--color-text-muted))]">
              <Icon name="mdi:progress-wrench" class="w-4 h-4" /> Untested
            </span>
          )}
        </div>
        <h3 class="mt-4 text-xl font-bold">{cam.name}</h3>
        <p class="mt-2 text-sm text-[rgb(var(--color-text-muted))]">{cam.notes}</p>
      </div>
    ))
  }
</div>

<div
  class="mt-6 hidden sm:block overflow-x-auto rounded-2xl border border-[rgb(var(--color-border))]"
>
  <table class="w-full text-sm border-collapse">
    <thead>
      <tr class="bg-[rgb(var(--color-secondary))]">
        <th class="text-left font-semibold px-4 py-3">Feature</th>
        {
          columns.map((c) => (
            <th class="font-semibold px-4 py-3 whitespace-nowrap">{c.label}</th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        FEATURES.map((f, i) => (
          <tr class={i % 2 ? "bg-[rgba(var(--color-secondary),0.4)]" : ""}>
            <td class="px-4 py-2.5 text-left">{f.label}</td>
            {columns.map((c) => (
              <td class="px-4 py-2.5 text-center">
                <Icon
                  name={cell(f[c.key]).icon}
                  class={`w-5 h-5 inline ${cell(f[c.key]).cls}`}
                />
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div class="mt-6 space-y-3 sm:hidden">
  {
    FEATURES.map((f) => (
      <div class="rounded-xl border border-[rgb(var(--color-border))] bg-[rgb(var(--color-card-bg))] p-4">
        <p class="font-semibold text-sm">{f.label}</p>
        <div class="mt-3 grid grid-cols-3 gap-2">
          {columns.map((c) => (
            <div class="flex flex-col items-center gap-1 rounded-lg bg-[rgb(var(--color-secondary))] py-2.5">
              <Icon
                name={cell(f[c.key]).icon}
                class={`w-5 h-5 ${cell(f[c.key]).cls}`}
              />
              <span class="text-[11px] leading-tight text-center text-[rgb(var(--color-text-muted))]">
                {c.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>

<div
  class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-[rgb(var(--color-text-muted))]"
>
  <span class="inline-flex items-center gap-1.5"
    ><Icon name="mdi:check-circle" class="w-4 h-4 text-emerald-500" /> Supported</span
  >
  <span class="inline-flex items-center gap-1.5"
    ><Icon
      name="mdi:circle-slice-5"
      class="w-4 h-4 text-[rgb(var(--color-accent))]"
    /> Partial / conditional</span
  >
  <span class="inline-flex items-center gap-1.5"
    ><Icon
      name="mdi:close-circle"
      class="w-4 h-4 text-[rgb(var(--color-danger))]"
    /> Unsupported</span
  >
</div>
