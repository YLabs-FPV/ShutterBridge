---
import { getLangFromUrl, useData } from "../../i18n";

interface Props {
  // "rgb": addressable WS2812, states told apart by colour (Waveshare ESP32-S3-Zero).
  // "mono": plain single-colour LED, states told apart by blink pattern instead
  // (ESP32-C3 Super Mini) - see StatusLed::updateMono in firmware/src/StatusLed.cpp.
  variant?: "rgb" | "mono";
}
const { variant = "rgb" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const d = useData(lang);

// Structural (colour + animation) stays here; the labels live in the locale files.
// Order matches led.states / led.statesMono: Connected, Recording, Searching, Config Wi-Fi.
const RGB_STYLE = [
  { color: "#22c55e", anim: "solid" },
  { color: "#ef4444", anim: "blink-slow" },
  { color: "#f59e0b", anim: "blink-slow" },
  { color: "#3b82f6", anim: "solid" },
];
const MONO_STYLE = [
  { color: "#3b82f6", anim: "solid" },
  { color: "#3b82f6", anim: "blink-fast" },
  { color: "#3b82f6", anim: "blink-slow" },
  { color: "#3b82f6", anim: "double-flash" },
];

const style = variant === "mono" ? MONO_STYLE : RGB_STYLE;
const text = d<{ label: string; pattern: string; meaning: string }[]>(
  variant === "mono" ? "led.statesMono" : "led.states",
);
const states = style.map((s, i) => ({ ...s, ...text[i] }));
---

<div class="led-status">
  {
    states.map((s) => (
      <div class="led-row">
        <span
          class:list={["led-dot", `led-dot-${s.anim}`]}
          style={`--led: ${s.color}`}
        />
        <div class="led-text">
          <span class="led-head">
            <strong>{s.label}</strong>
            <span class="led-pattern">{s.pattern}</span>
          </span>
          <span class="led-meaning">{s.meaning}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .led-status {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1.25rem 0;
  }
  .led-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.6rem;
    background: rgb(var(--color-card-bg));
  }
  .led-dot {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.3rem;
    border-radius: 9999px;
    background: var(--led);
    box-shadow: 0 0 10px var(--led);
  }
  .led-dot-blink-slow {
    animation: led-blink 1s steps(1) infinite;
  }
  .led-dot-blink-fast {
    animation: led-blink 0.3s steps(1) infinite;
  }
  .led-dot-double-flash {
    animation: led-double-flash 1.5s steps(1) infinite;
  }
  .led-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .led-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .led-pattern {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    color: rgb(var(--color-text-muted));
    background: rgb(var(--color-secondary));
  }
  .led-meaning {
    font-size: 0.9rem;
    color: rgb(var(--color-text-muted));
  }
  @keyframes led-blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0.2;
    }
  }
  /* Two quick flashes (0-100ms, 250-350ms) then off for the rest of a 1.5s cycle -
     mirrors the double-flash timing in StatusLed::updateMono */
  @keyframes led-double-flash {
    0%,
    6% {
      opacity: 1;
    }
    7%,
    16% {
      opacity: 0.2;
    }
    17%,
    23% {
      opacity: 1;
    }
    24%,
    100% {
      opacity: 0.2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .led-dot-blink-slow,
    .led-dot-blink-fast,
    .led-dot-double-flash {
      animation: none;
    }
  }
</style>
