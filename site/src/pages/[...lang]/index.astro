---
import MainLayout from "../../layouts/MainLayout.astro";
import Hero from "../../components/home/Hero.astro";
import Compatibility from "../../components/home/Compatibility.astro";
import Requirements from "../../components/home/Requirements.astro";
import Gallery from "../../components/home/Gallery.astro";
import { SITE_TITLE } from "../../consts";
import { getLangFromUrl, useTranslations } from "../../i18n";
import { getLangPaths } from "../../i18n/getLangPaths";

export const getStaticPaths = getLangPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<MainLayout title={`${SITE_TITLE} - ${t("site.titleSuffix")}`}>
  <Hero />
  <Gallery />
  <Compatibility />
  <Requirements />
</MainLayout>
