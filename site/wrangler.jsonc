{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "shutterbridge",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Run the worker BEFORE serving assets for the un-prefixed entry paths so
		// the on-demand [...path] page renders and can locale-detect. Image dirs
		// under /docs are excluded so they stay served straight from the CDN.
		"run_worker_first": [
			"/flash",
			"/flash/",
			"/docs",
			"/docs/*",
			"!/docs/hardware/*",
			"!/docs/webui/*",
			"!/docs/wiring/*"
		]
	},
	"observability": {
		"enabled": true
	}
}