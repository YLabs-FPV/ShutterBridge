{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "shutterbridge",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Cloudflare serves static assets (and 404.html for a miss) BEFORE the
		// worker runs, so middleware never sees un-prefixed paths like /docs.
		// run_worker_first forces the worker to run first for these patterns so
		// the middleware locale-redirect executes. Asset sub-dirs under /docs are
		// excluded so images are still served directly.
		"run_worker_first": [
			"/",
			"/flash",
			"/docs",
			"/docs/*",
			"!/docs/hardware/*",
			"!/docs/webui/*",
			"!/docs/wiring/*"
		]
	},
	"observability": {
		"enabled": true
	}
}